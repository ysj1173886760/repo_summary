# Copy this file to .env and fill in your own values.

# GitHub personal access token (optional but strongly recommended to avoid rate limits).
# Create one at https://github.com/settings/tokens
GH_TOKEN=

# OpenAI-compatible API configuration.
# Works with OpenAI as well as any OpenAI-compatible endpoint (Azure OpenAI,
# DeepSeek, Together, OpenRouter, local vLLM/Ollama, Gemini's OpenAI-compatible
# endpoint, etc.) -- just point OPENAI_BASE_URL at the right place.
OPENAI_API_KEY=
# Leave empty to use the official OpenAI endpoint, or set a custom one, e.g.:
#   https://openrouter.ai/api/v1
#   https://api.deepseek.com/v1
#   https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Default model name (override per-run with --model).
OPENAI_MODEL=deepseek/deepseek-v4-pro
